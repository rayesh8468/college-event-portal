# ═══════════════════════════════════════════════════════════════════
# College Event Portal — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# 복사: cp .env.example .env.local
# 작성 후 각 값을 실제 값으로 교체하세요.
# ═══════════════════════════════════════════════════════════════════

# ── AWS (4 Services) ────────────────────────────────────────────────

# AWS 리전 (인도 뭄바이: ap-south-1)
AWS_REGION=ap-south-1

# AWS 액세스 키 (IAM 사용자 또는 역할에서 발급)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB 테이블명 (CDK 스택과 일치해야 함)
EVENTS_TABLE=College_Events
REGISTRATIONS_TABLE=College_Registrations
USERS_TABLE=College_Users
ACTIVITY_POINTS_TABLE=College_ActivityPoints
CERTIFICATES_TABLE=College_Certificates
OD_REQUESTS_TABLE=College_ODRequests
FEEDBACK_TABLE=College_Feedback
DEPARTMENTS_TABLE=College_Departments
PAYMENTS_TABLE=College_Payments

# S3 문서 버킷명 (CDK 배포 후 cdk-outputs.json에서 확인)
DOCUMENTS_BUCKET=college-portal-docs-vit-ac-in

# ── Cognito ─────────────────────────────────────────────────────────

# Cognito User Pool ID (CDK deploy 후 확인)
COGNITO_USER_POOL_ID=

# Cognito App Client ID (CDK deploy 후 확인)
COGNITO_CLIENT_ID=

# 가입 허용 이메일 도메인 (Cognito PreSignUp 트리거와 일치)
COLLEGE_EMAIL_DOMAIN=vit.ac.in

# ── 외부 무료 서비스 ───────────────────────────────────────────────

# Resend (이메일 — 3,000건/월 무료)
RESEND_API_KEY=

# Cloudinary (이미지 CDN — 25GB 무료)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (결제)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Sentry (에러 모니터링)
SENTRY_DSN=

# ── 옵션 ────────────────────────────────────────────────────────────

# Vercel Cron 시크릿 (예약 작업 보호용)
VERCEL_CRON_SECRET=

# 데모 모드 토글 (프로덕션 배포 시 false)
NEXT_PUBLIC_DEMO_MODE=true
